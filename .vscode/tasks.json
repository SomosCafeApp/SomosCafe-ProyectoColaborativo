{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "🚀 Iniciar Backend",
      "type": "npm",
      "script": "dev",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "runOptions": {
        "runOn": "folderOpen"
      },
      "problemMatcher": []
    },
    {
      "label": "📱 Iniciar Frontend Flutter",
      "type": "shell",
      "command": "flutter run",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "runOptions": {
        "runOn": "folderOpen"
      },
      "problemMatcher": []
    },
    {
      "label": "📦 Instalar Dependencias Backend",
      "type": "shell",
      "command": "npm install",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "problemMatcher": []
    },
    {
      "label": "🔍 Verificar Backend",
      "type": "shell",
      "command": "node --check server.js",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "problemMatcher": []
    },
    {
      "label": "🧪 Ejecutar Pruebas Backend",
      "type": "npm",
      "script": "test",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "problemMatcher": []
    },
    {
      "label": "🛠️ Preparar Backend",
      "dependsOn": [
        "📦 Instalar Dependencias Backend",
        "🔍 Verificar Backend"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "🩺 Verificar Estado Backend",
      "type": "shell",
      "command": "curl http://localhost:3000/",
      "problemMatcher": []
    }
  ]
}