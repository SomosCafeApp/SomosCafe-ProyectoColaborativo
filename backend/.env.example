# ===== Servidor / base de datos =====
PORT=5000
MONGO_URI=
JWT_SECRET=

# ===== Cloudinary (imágenes de productos, eventos, perfiles, comprobantes) =====
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ===== Soporte por WhatsApp =====
# Número de WhatsApp del negocio, CON indicativo del país (Colombia = 57).
# Acepta "573001234567", "+57 300 123 4567" o "3001234567" (se le agrega 57).
# Si se deja vacío, la app muestra un aviso en vez de abrir un enlace roto.
SUPPORT_WHATSAPP=573001234567
# Mensaje que llega precargado en el chat (opcional).
SUPPORT_WHATSAPP_MESSAGE=Hola Somos Café, necesito ayuda con mi pedido.
# Indicativo por defecto para números de 10 dígitos sin indicativo (opcional).
SUPPORT_WHATSAPP_COUNTRY_CODE=57
